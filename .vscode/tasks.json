{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Generate git info",
            "type": "shell",
            "command": "dart run scripts/generate_git_info.dart",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Generate translations",
            "type": "shell",
            "command": "dart run intl_utils:generate",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "pub get",
            "type": "shell",
            "command": "flutter pub get",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run — macOS (debug)",
            "type": "shell",
            "command": "flutter run -d macos",
            "dependsOn": [
                "Generate git info"
            ],
            "group": "test",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "owner": "flutter",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Launching",
                    "endsPattern": "^(Flutter run key commands|An Observatory debugger)"
                }
            }
        },
        {
            "label": "Run — Windows (debug)",
            "type": "shell",
            "command": "flutter run -d windows",
            "dependsOn": [
                "Generate git info"
            ],
            "group": "test",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Run — Linux (debug)",
            "type": "shell",
            "command": "flutter run -d linux",
            "dependsOn": [
                "Generate git info"
            ],
            "group": "test",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Build — macOS (release)",
            "type": "shell",
            "command": "flutter build macos --release",
            "dependsOn": [
                "Generate git info"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$dart-build"
            ]
        },
        {
            "label": "Build — Windows (release)",
            "type": "shell",
            "command": "flutter build windows --release",
            "dependsOn": [
                "Generate git info"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$dart-build"
            ]
        },
        {
            "label": "Build — Linux (release)",
            "type": "shell",
            "command": "flutter build linux --release",
            "dependsOn": [
                "Generate git info"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$dart-build"
            ]
        },
        {
            "label": "flutter analyze",
            "type": "shell",
            "command": "flutter analyze",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$dart-build"
            ]
        }
    ]
}